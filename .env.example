# Copiar este archivo como .env y completar valores reales.
# .env esta en .gitignore - NUNCA subir secretos reales al repositorio.

# ---- Perfil activo ----
SPRING_PROFILES_ACTIVE=dev

# ---- Base de datos ----
# En local con docker-compose estos ya vienen definidos en docker-compose.yml.
# En Railway, se configuran en el panel del servicio backend (Settings > Variables),
# referenciando el plugin de Postgres:
#   SPRING_DATASOURCE_URL=jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
#   SPRING_DATASOURCE_USERNAME=${{Postgres.PGUSER}}
#   SPRING_DATASOURCE_PASSWORD=${{Postgres.PGPASSWORD}}
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/avance_produccion
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# ---- Seguridad JWT ----
# Generar uno propio y unico para produccion, minimo 32 caracteres.
# Ejemplo para generar uno: openssl rand -base64 32
JWT_SECRET=cambiar-este-valor-en-produccion-minimo-32-caracteres
JWT_EXPIRATION_MS=86400000

# ---- CORS ----
# En prod, el dominio real del frontend (ej: Vercel)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---- Servidor ----
PORT=8080
